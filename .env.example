# Kopiera till .env.local och fyll i. .env.local ska aldrig checkas in.

# Resend — driver kontaktformuläret. Skapa konto på https://resend.com,
# verifiera din domän och hämta en API-nyckel.
RESEND_API_KEY=

# Avsändaradress för formulärmejlen. Måste ligga på en domän du verifierat
# hos Resend, t.ex. "seria <noreply@seria.se>".
CONTACT_FROM_EMAIL=

# Utan dessa två visar formuläret ett ärligt felmeddelande i stället för att
# låtsas att meddelandet gick fram. I utveckling loggas inskicket i terminalen.
